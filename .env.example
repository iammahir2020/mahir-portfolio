# Copy this file to .env (for `vercel dev`) or set these in the Vercel project's
# Environment Variables settings for the deployed site.

# The Gmail address used to send contact-form emails.
GMAIL_USER=your-address@gmail.com

# A Gmail App Password (not your regular password) — requires 2-Step
# Verification enabled on the Google account. Generate one at:
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Optional: where contact-form messages are delivered. Defaults to GMAIL_USER.
CONTACT_TO_EMAIL=your-address@example.com

# Comma-separated list of origins allowed to POST to /api/contact. Set this to
# your production domain(s) so the endpoint cannot be used as an open mail relay.
# Vercel deployment URLs and localhost are permitted automatically.
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
